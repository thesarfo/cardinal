# BETWEEN and IN, with and without NOT.

statement ok
CREATE TABLE t (n INT, s TEXT)

statement ok
INSERT INTO t VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e'), (NULL, 'f')

query I
SELECT n FROM t WHERE n BETWEEN 2 AND 4
----
2
3
4

# Both ends are included.
query I
SELECT n FROM t WHERE n BETWEEN 5 AND 5
----
5

query I
SELECT n FROM t WHERE n NOT BETWEEN 2 AND 4
----
1
5

query I
SELECT n FROM t WHERE n BETWEEN 4 AND 2
----

# The AND after BETWEEN's bounds is a normal AND.
query I
SELECT n FROM t WHERE n BETWEEN 1 AND 5 AND n <> 3
----
1
2
4
5

query I
SELECT n FROM t WHERE n IN (1, 3, 5)
----
1
3
5

query I
SELECT n FROM t WHERE n NOT IN (1, 3, 5)
----
2
4

query I
SELECT n FROM t WHERE n IN (4)
----
4

query T
SELECT s FROM t WHERE s IN ('a', 'f', 'z')
----
a
f

query I
SELECT n FROM t WHERE n IN (1 + 1, 2 * 2)
----
2
4

# NULL in the data never matches, not even NOT IN.
query I
SELECT n FROM t WHERE n NOT IN (100)
----
1
2
3
4
5

# NULL in the list: a match still wins, but no match is unknown.
query I
SELECT n FROM t WHERE n IN (1, NULL)
----
1

query I
SELECT n FROM t WHERE n NOT IN (1, NULL)
----

query I
SELECT n FROM t WHERE n BETWEEN 1 AND NULL
----
