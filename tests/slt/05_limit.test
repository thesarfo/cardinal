# LIMIT takes the first N rows after everything else.

statement ok
CREATE TABLE t (n INT)

statement ok
INSERT INTO t VALUES (5), (3), (9), (1), (7)

query I nosort
SELECT n FROM t LIMIT 2
----
5
3

query I nosort
SELECT n FROM t ORDER BY n LIMIT 3
----
1
3
5

query I nosort
SELECT n FROM t ORDER BY n DESC LIMIT 1
----
9

query I
SELECT n FROM t LIMIT 0
----

# More than there are rows is fine.
query I rowsort
SELECT n FROM t LIMIT 100
----
1
3
5
7
9

# LIMIT comes after WHERE and ORDER BY.
query I nosort
SELECT n FROM t WHERE n > 2 ORDER BY n LIMIT 2
----
3
5

query I
SELECT n FROM t WHERE n > 100 LIMIT 5
----

statement error
SELECT n FROM t LIMIT -1

statement error
SELECT n FROM t LIMIT 1.5
