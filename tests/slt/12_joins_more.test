# A table joined to itself, and three tables.

statement ok
CREATE TABLE people (id INT, name TEXT, boss INT)

statement ok
INSERT INTO people VALUES (1, 'ama', NULL), (2, 'kofi', 1), (3, 'esi', 1), (4, 'yaw', 2)

# Each person next to their boss. ama has no boss and so no row.
query TT rowsort
SELECT p.name, b.name FROM people p JOIN people b ON p.boss = b.id
----
esi
ama
kofi
ama
yaw
kofi

# Two steps up.
query TT rowsort
SELECT p.name, g.name FROM people p JOIN people b ON p.boss = b.id JOIN people g ON b.boss = g.id
----
yaw
ama

# Pairs of different people with the same boss.
query TT rowsort
SELECT a.name, b.name FROM people a JOIN people b ON a.boss = b.boss AND a.id < b.id
----
kofi
esi

statement ok
CREATE TABLE users (id INT, name TEXT)

statement ok
CREATE TABLE orders (id INT, user_id INT)

statement ok
CREATE TABLE items (id INT, order_id INT, sku TEXT)

statement ok
INSERT INTO users VALUES (1, 'ama'), (2, 'kofi'), (3, 'esi')

statement ok
INSERT INTO orders VALUES (10, 1), (11, 1), (12, 3)

statement ok
INSERT INTO items VALUES (100, 10, 'x'), (101, 10, 'y'), (102, 12, 'z'), (103, 99, 'w')

query TT rowsort
SELECT u.name, i.sku FROM users u JOIN orders o ON u.id = o.user_id JOIN items i ON o.id = i.order_id
----
ama
x
ama
y
esi
z

query TT rowsort
SELECT u.name, i.sku FROM users u, orders o, items i WHERE u.id = o.user_id AND o.id = i.order_id
----
ama
x
ama
y
esi
z

# Mixing a comma and a JOIN.
query TT rowsort
SELECT u.name, i.sku FROM users u, orders o JOIN items i ON o.id = i.order_id WHERE u.id = o.user_id
----
ama
x
ama
y
esi
z

# Conditions that use constants fold away and the answer stays the same.
query TT rowsort
SELECT u.name, i.sku FROM users u JOIN orders o ON u.id = o.user_id AND 1 = 1 JOIN items i ON o.id = i.order_id AND TRUE
----
ama
x
ama
y
esi
z

query I
SELECT u.id FROM users u, orders o, items i WHERE 1 > 2
----

# An order with no items and an item with no order are in no row.
query I rowsort
SELECT o.id FROM orders o JOIN items i ON o.id = i.order_id
----
10
10
12
